// MAIN FUNCTION
//==================================================
int main()
{
    int n;

    cout << "============================================\n";
    cout << "        HEAP SORT PERFORMANCE TEST          \n";
    cout << "============================================\n";

    cout << "Enter number of elements: ";
    cin >> n;

    if (cin.fail() || n <= 0)
    {
        cout << "Invalid input! Enter a positive number.\n";
        return 1;
    }

    // Create random array
    vector<int> original(n);

    srand(static_cast<unsigned int>(time(nullptr)));

    for (int i = 0; i < n; i++)
        original[i] = rand() % 100000;

    // Create copies for both sorting methods
    vector<int> maxHeapArray = original;
    vector<int> minHeapArray = original;

    //==================================================
    // MAX HEAP SORT TIMING
    //==================================================
    auto startMax = high_resolution_clock::now();

    maxHeapSort(maxHeapArray);

    auto endMax = high_resolution_clock::now();

    //==================================================
    // MIN HEAP SORT TIMING
    //==================================================
    auto startMin = high_resolution_clock::now();

    minHeapSort(minHeapArray);

    auto endMin = high_resolution_clock::now();

    // Calculate times
    auto maxNano =
        duration_cast<nanoseconds>(endMax - startMax).count();

    auto maxMicro =
        duration_cast<microseconds>(endMax - startMax).count();

    auto maxMilli =
        duration_cast<milliseconds>(endMax - startMax).count();

    auto minNano =
        duration_cast<nanoseconds>(endMin - startMin).count();

    auto minMicro =
        duration_cast<microseconds>(endMin - startMin).count();

    auto minMilli =
        duration_cast<milliseconds>(endMin - startMin).count();

    //==================================================
    // DISPLAY RESULTS
    //==================================================

    cout << "\n============================================\n";
    cout << "              TEST RESULTS                 \n";
    cout << "============================================\n";

    cout << "Number of Elements : " << n << "\n";

    cout << "\nOriginal Array Sample:\n";
    displaySample(original);

    cout << "\n---------- MAX HEAP SORT ----------\n";
    cout << "Time (ns)  : " << maxNano << " ns\n";
    cout << "Time (us)  : " << maxMicro << " us\n";
    cout << "Time (ms)  : " << maxMilli << " ms\n";
    cout << "Sorted     : "
         << (isSorted(maxHeapArray) ? "Yes" : "No") << "\n";

    cout << "\nSorted Array Sample:\n";
    displaySample(maxHeapArray);

    cout << "\n---------- MIN HEAP SORT ----------\n";
    cout << "Time (ns)  : " << minNano << " ns\n";
    cout << "Time (us)  : " << minMicro << " us\n";
    cout << "Time (ms)  : " << minMilli << " ms\n";
    cout << "Sorted     : "
         << (isSorted(minHeapArray) ? "Yes" : "No") << "\n";

    cout << "\nSorted Array Sample:\n";
    displaySample(minHeapArray);

    //==================================================
    // COMPLEXITY
    //==================================================

    cout << "\n============================================\n";
    cout << "              COMPLEXITY                   \n";
    cout << "============================================\n";

    cout << "Max Heap Sort : O(n log n)\n";
    cout << "Min Heap Sort : O(n log n)\n";
    cout << "Extra Space   : O(log n) recursion stack\n";

    //==================================================
    // COMPARISON
    //==================================================

    cout << "\n============================================\n";
    cout << "              COMPARISON                   \n";
    cout << "============================================\n";

    if (maxNano < minNano)
        cout << "Max Heap Sort is faster for this test.\n";
    else if (minNano < maxNano)
        cout << "Min Heap Sort is faster for this test.\n";
    else
        cout << "Both algorithms took the same time.\n";

    return 0;
}
