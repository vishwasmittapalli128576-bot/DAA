using namespace std;
using namespace chrono;

//==================================================
// MAX HEAPIFY
//==================================================
void maxHeapify(vector<int>& arr, int size, int index)
{
    int largest = index;
    int leftChild = 2 * index + 1;
    int rightChild = 2 * index + 2;

    if (leftChild < size && arr[leftChild] > arr[largest])
        largest = leftChild;

    if (rightChild < size && arr[rightChild] > arr[largest])
        largest = rightChild;

    if (largest != index)
    {
        swap(arr[index], arr[largest]);
        maxHeapify(arr, size, largest);
    }
}

//==================================================
// MAX HEAP SORT
//==================================================
void maxHeapSort(vector<int>& arr)
{
    int size = arr.size();

    // Build Max Heap
    for (int i = size / 2 - 1; i >= 0; i--)
        maxHeapify(arr, size, i);

    // Extract elements from heap
    for (int i = size - 1; i > 0; i--)
    {
        swap(arr[0], arr[i]);
        maxHeapify(arr, i, 0);
    }
}

//==================================================
// MIN HEAPIFY
//==================================================
void minHeapify(vector<int>& arr, int size, int index)
{
    int smallest = index;
    int leftChild = 2 * index + 1;
    int rightChild = 2 * index + 2;

    if (leftChild < size && arr[leftChild] < arr[smallest])
        smallest = leftChild;

    if (rightChild < size && arr[rightChild] < arr[smallest])
        smallest = rightChild;

    if (smallest != index)
    {
        swap(arr[index], arr[smallest]);
        minHeapify(arr, size, smallest);
    }
}

//==================================================
// MIN HEAP SORT
//==================================================
void minHeapSort(vector<int>& arr)
{
    int size = arr.size();

    // Build Min Heap
    for (int i = size / 2 - 1; i >= 0; i--)
        minHeapify(arr, size, i);

    // Extract elements
    for (int i = size - 1; i > 0; i--)
    {
        swap(arr[0], arr[i]);
        minHeapify(arr, i, 0);
    }

    // Convert descending order to ascending order
    reverse(arr.begin(), arr.end());
}

//==================================================
// CHECK WHETHER ARRAY IS SORTED
//==================================================
bool isSorted(const vector<int>& arr)
{
    return is_sorted(arr.begin(), arr.end());
}

//==================================================
// DISPLAY FIRST FEW ELEMENTS
//==================================================
void displaySample(const vector<int>& arr)
{
    int limit = min(10, static_cast<int>(arr.size()));

    for (int i = 0; i < limit; i++)
        cout << arr[i] << " ";

    if (arr.size() > 10)
        cout << "...";

    cout << endl;
}

